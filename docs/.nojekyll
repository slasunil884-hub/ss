const langCycle = ["SI", "EN", "SG"];
const langLabel = {
  SI: "Sinhala",
  EN: "English",
  SG: "Singlish"
};

const chatWindow = document.getElementById("chatWindow");
const chatInput = document.getElementById("chatInput");
const sendBtn = document.getElementById("sendBtn");
const langToggle = document.getElementById("langToggle");

function appendMessage(role, text) {
  const row = document.createElement("div");
  row.className = `chat-msg ${role === "USER" ? "user" : "system"}`;

  const tag = document.createElement("span");
  tag.className = "role";
  tag.textContent = role === "USER" ? "[ඔබ]" : "[RAVI]";

  const content = document.createElement("span");
  content.textContent = text;

  row.append(tag, content);
  chatWindow.appendChild(row);
  chatWindow.scrollTop = chatWindow.scrollHeight;
}

function processUserInput(value) {
  const text = value.trim();
  if (!text) return;

  appendMessage("USER", text);
  chatInput.value = "";

  const lower = text.toLowerCase();

  if (lower.includes("photosynthesis") || lower.includes("ප්‍රභාසංස්ලේෂනය") || lower.includes("photosynthesis")) {
    appendMessage("RAVI", "ප්‍රභාසංස්ලේෂනය යනු හරිත ලෝකයේදී CO₂ සහ ජලය විකිරණයෙන් ප්‍රතිසංස්කරණය කර ග්ලූකෝස් නිපදවීමයි. ඔක්සිජන් ද දාර වන්නේ." );
    return;
  }

  if (lower.includes("arduino") || lower.includes("රොබෝ") || lower.includes("robot") || lower.includes("ආර්ඩුයිනෝ")) {
    appendMessage("RAVI", "මම ඔබට සම්පූර්ණ Arduino sketch එකක් සකස් කළ හැක. සංරචක, pin layout, සහ අදාළ code ලියන්න මට දියුණු විස්තර දෙන්න.");
    return;
  }

  if (lower.includes("study") || lower.includes("exam") || lower.includes("quiz") || lower.includes("අධ්‍යාපනය") || lower.includes("ප්‍රශ්න")) {
    appendMessage("RAVI", "අධ්‍යයන sprint එකක් ගමු: 15 මිනිත්තු recall, 10 මිනිත්තු සූත්‍ර, 10 මිනිත්තු quiz review. ඔබේ ශ්‍රේණිය හා විෂය අනුව මම සැලසුම සකස් කර දෙන්නම්.");
    return;
  }

  if (lower.includes("music") || lower.includes("focus") || lower.includes("සංගීත") || lower.includes("නැඹුරු")) {
    appendMessage("RAVI", "Focus mode සක්‍රීයයි. 25 මිනිතු කාලය සඳහා මෘදු synthwave හෝ උපකාරක ඩ්‍රම් Music එකක් තෝරාගන්න. වැඩේට පමණක් යන්න.");
    return;
  }

  appendMessage("RAVI", `අණය ලැබී ඇත: "${text}". RAVI ඔබේ පද්ධතිය සමඟ සම්බන්ධ වී හොඳම ක්‍රියාමාර්ගය සකස් කරමින් පවතී.`);
}

sendBtn.addEventListener("click", () => processUserInput(chatInput.value));
chatInput.addEventListener("keydown", (event) => {
  if (event.key === "Enter") processUserInput(chatInput.value);
});

for (const prompt of document.querySelectorAll(".prompt-btn")) {
  prompt.addEventListener("click", () => {
    const text = prompt.textContent;
    chatInput.value = text;
    processUserInput(text);
  });
}

for (const nav of document.querySelectorAll(".nav-pill")) {
  nav.addEventListener("click", () => {
    document.querySelectorAll(".nav-pill").forEach((btn) => btn.classList.remove("active"));
    nav.classList.add("active");

    const target = nav.dataset.target;
    const anchor = document.getElementById(target);
    if (anchor) {
      anchor.scrollIntoView({ behavior: "smooth", block: "start" });
    }
  });
}

let langIndex = 0;
langToggle.addEventListener("click", () => {
  langIndex = (langIndex + 1) % langCycle.length;
  const next = langCycle[langIndex];
  langToggle.textContent = next;
  langToggle.title = langLabel[next];

  const label = langLabel[next];
  document.title = `Shadow Supporter | ${label} RAVI Core`;

  const status = document.querySelector(".status-indicator");
  if (status) {
    const textNode = status.lastChild;
    if (next === "SI") textNode.textContent = " සක්‍රීයයි";
    else if (next === "EN") textNode.textContent = " ONLINE";
    else textNode.textContent = " SINGLISH MODE";
  }
});

const primaryBtn = document.querySelector(".primary-btn");
if (primaryBtn) {
  primaryBtn.addEventListener("click", () => {
    const welcome = "RAVI පද්ධතිය සක්‍රීයයි. සියලුම වීර මොඩියුල පවතිනවා.";
    appendMessage("RAVI", welcome);
    chatInput.focus();
  });
}

if (chatWindow) {
  appendMessage("RAVI", "Shadow Supporter සක්‍රීයයි. ඔබේ වීර මිතුරා සූදානම්." );
}

const defaultStatus = document.querySelector(".status-indicator");
if (defaultStatus) {
  defaultStatus.lastChild.textContent = " සක්‍රීයයි";
}
